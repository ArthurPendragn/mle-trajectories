# Copy to hpc/config.env. Inline environment overrides take precedence.
export SSH_HOST="${SSH_HOST:-hpc}"
export CLUSTER_PROJECT_DIR="${CLUSTER_PROJECT_DIR:-}" # e.g. /beegfs/scratch/YOU/mle-trajectories
export ACCOUNT="${ACCOUNT:-}"
export PARTITION="${PARTITION:-standard}"
export WORKER_CPUS="${WORKER_CPUS:-16}"
export WORKER_MEM="${WORKER_MEM:-60G}"
export TIME_WORKER="${TIME_WORKER:-02:00:00}"
export CONCURRENCY="${CONCURRENCY:-1}"
export EXCLUSIVE="${EXCLUSIVE:-1}" # reserve a node to avoid other jobs sharing it
export CONTAINER_MODULE="${CONTAINER_MODULE:-singularity}"
# Optional: HPC_CONTAINER=apptainer, SIF=/absolute/path/to/image.sif
# Optional reader ADC JSON: explicitly bound read-only; never included in the image.
export GCS_CREDENTIALS="${GCS_CREDENTIALS:-}"
# Extra data mounts, e.g. when input/ symlinks point outside this checkout:
HPC_EXTRA_BINDS=() # e.g. ("/beegfs/scratch/YOU/datasets")
