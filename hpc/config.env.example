# Copy to hpc/config.env and edit. Job scripts derive REPO from the checkout
# location; this path is only for push.sh / fetch.sh.
#   cp hpc/config.env.example hpc/config.env

# Absolute path of this repo on the cluster scratch filesystem.
export CLUSTER_PROJECT_DIR="/beegfs/scratch/schustet/mle-trajectories"

# SSH host alias (see ~/.ssh/config) used by push.sh / fetch.sh.
export SSH_HOST="hpc"

# ---- SLURM ----
export ACCOUNT=""
export PARTITION="standard"
export TIME_WORKER="24:00:00"
export WORKER_CPUS="8"
export WORKER_MEM="32G"
# One batch per array task. Keep this low: each task calls the LLM, then
# trains. 1 is safe for API quotas; 2 runs two families at once.
export CONCURRENCY="1"
# Broken GPU nodes on this site. Empty string omits --exclude.
export EXCLUDE="gpu[028-042]"

# ---- skrubify ----
# Same conversion as the local command. Swap these for Gemini if that is the
# key in hpc/secrets.env (GEMINI_API_KEY, or GOOGLE_API_KEY which env.sh copies).
export PROVIDER="openai"
export MODEL="gpt-5.6-sol"
export ENGINE="stratum"
export RUN_IN="titanic"
export PIPELINE_DIR="titanic/mle_star_flash_run_1/pipelines/1"
# 1 passes --compare-source. A score gap is expected and does not fail the job.
export COMPARE_SOURCE="1"
