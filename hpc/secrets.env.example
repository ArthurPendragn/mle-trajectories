# Copy to hpc/secrets.env and chmod 600. Never commit the copy.
#   cp hpc/secrets.env.example hpc/secrets.env && chmod 600 hpc/secrets.env
#
# The provider in hpc/config.env decides which key is required.
# openai  -> OPENAI_API_KEY
# gemini  -> GEMINI_API_KEY. If you only have GOOGLE_API_KEY (the mle-star
#            secrets file), leave GEMINI_API_KEY empty: env.sh copies it.

OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
